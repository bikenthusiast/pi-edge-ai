# Where the Pi lives. Read by the Makefile (include) and by scripts/deploy.sh
# (source), so keep it valid in BOTH: KEY=value, no spaces around '=', no
# quotes. For a one-off override: make deploy PI_HOST=otherpi

# SSH host: a Host alias from ~/.ssh/config, a hostname or an IP.
PI_HOST=mirror

# Project directory on the Pi, relative to the home directory there. Do not
# use '~': bash would expand it to the home directory on the Mac.
PI_PATH=Projects/pi-edge-ai
